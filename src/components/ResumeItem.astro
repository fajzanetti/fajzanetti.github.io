---
interface Props {
  title: string;
  subtitle: string;
  dates: string[];
  description?: string | string[];
}
const { title, subtitle, dates, description } = Astro.props;
const paragraphs = Array.isArray(description) ? description : description ? [description] : [];
---

<article class="mb-10 grid gap-1 md:grid-cols-[170px_1fr] md:gap-8">
  <div class="text-sm font-bold whitespace-nowrap text-accent md:pt-1.5">
    {dates.map((date) => <div>{date}</div>)}
  </div>
  <div>
    <h3 class="text-[22px] leading-snug">{title}</h3>
    <p class="mt-1 text-[15px] text-muted">{subtitle}</p>
    {paragraphs.map((text) => <p class="mt-2 text-muted">{text}</p>)}
  </div>
</article>
