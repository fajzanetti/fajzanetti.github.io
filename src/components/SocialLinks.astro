---
import { Icon } from 'astro-icon/components';
import type { Social } from '../data/types';

interface Props {
  socials: Social[];
}
const { socials } = Astro.props;
---

<ul class="flex gap-3">
  {socials.map(({ label, url, icon }) => (
    <li>
      <a
        href={url}
        aria-label={label}
        target="_blank"
        rel="noopener noreferrer"
        class="flex size-11 items-center justify-center rounded-full border border-rule bg-surface text-text transition-colors hover:border-accent hover:text-accent"
      >
        <Icon name={icon} class="size-5" aria-hidden="true" />
      </a>
    </li>
  ))}
</ul>
