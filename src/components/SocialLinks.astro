---
import { Icon } from 'astro-icon/components';
import type { Social } from '../data/types';

interface Props {
  socials: Social[];
}
const { socials } = Astro.props;
---

<!-- a margem negativa alinha os ícones à coluna de texto, sem reduzir a área de toque -->
<ul class="-mx-2.5 flex justify-between">
  {socials.map(({ label, url, icon }) => (
    <li>
      <a
        href={url}
        aria-label={label}
        target="_blank"
        rel="noopener noreferrer"
        class="flex size-11 items-center justify-center rounded-full text-muted transition-colors hover:text-accent"
      >
        <Icon name={icon} class="size-6" aria-hidden="true" />
      </a>
    </li>
  ))}
</ul>
