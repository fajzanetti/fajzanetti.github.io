---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import type { Project } from '../data/types';
import { formatPeriod } from '../lib/format';

interface Props {
  project: Project;
}
const { project } = Astro.props;
---

<article class="flex flex-col overflow-hidden rounded-2xl border border-rule bg-surface">
  {project.image ? (
    <Image
      src={project.image}
      alt={project.imageAlt ?? ''}
      width={800}
      height={500}
      class="aspect-[16/10] w-full border-b border-rule object-cover object-top"
    />
  ) : (
    <div class="flex aspect-[16/10] items-center justify-center border-b border-rule bg-accent-soft">
      <Icon name="mdi:school-outline" class="size-14 text-accent" aria-hidden="true" />
    </div>
  )}
  <div class="flex grow flex-col p-5">
    <p class="text-xs font-bold text-accent">{formatPeriod(project.period)}</p>
    <h3 class="mt-1 text-xl leading-snug">{project.name}</h3>
    <p class="mt-1 text-sm text-muted">{project.tagline}</p>
    {project.description.map((text) => <p class="mt-3 text-sm">{text}</p>)}
    <p class="mt-3 text-xs text-muted">{project.stack.join(' · ')}</p>
    {project.links.length > 0 && (
      <ul class="mt-auto flex flex-wrap gap-x-4 gap-y-1 pt-4">
        {project.links.map(({ label, url }) => (
          <li>
            <a
              href={url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1 text-sm font-bold text-accent underline underline-offset-2 hover:text-text"
            >
              {label}
              <Icon name="mdi:open-in-new" class="size-3.5" aria-hidden="true" />
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
</article>
