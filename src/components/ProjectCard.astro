---
import { Image } from 'astro:assets';
import type { Project } from '../data/types';
import { formatPeriod } from '../lib/format';
import ProjectLinks from './ProjectLinks.astro';
import StackList from './StackList.astro';

interface Props {
  project: Project;
}
const { project } = Astro.props;
---

<article class="flex flex-col overflow-hidden rounded-3xl border border-rule bg-surface">
  {project.image && (
    <Image
      src={project.image}
      alt={project.imageAlt ?? ''}
      width={1100}
      height={688}
      class="aspect-[16/10] w-full border-b border-rule object-cover object-top"
    />
  )}
  <div class="flex grow flex-col p-7 md:p-8">
    <p class="text-sm font-bold text-accent">{formatPeriod(project.period)}</p>
    <h3 class="mt-1 text-2xl leading-snug md:text-[28px]">{project.name}</h3>
    <p class="mt-2 text-[17px] leading-snug">{project.tagline}</p>
    {project.description.map((text) => <p class="mt-3 text-[15px] text-muted">{text}</p>)}
    <div class="mt-5 mb-6">
      <StackList stack={project.stack} />
    </div>
    <div class="mt-auto">
      <ProjectLinks links={project.links} />
    </div>
  </div>
</article>
