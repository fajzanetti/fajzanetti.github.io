---
import { featuredProject, otherProjects, projectsIntro, radioProjects } from '../data/projects';
import ProjectCard from './ProjectCard.astro';
import ProjectFeatured from './ProjectFeatured.astro';
import ProjectRow from './ProjectRow.astro';
import Section from './Section.astro';
---

<Section id="projetos" title="Projetos">
  <p class="-mt-6 mb-8 max-w-[620px] text-lg text-muted">{projectsIntro}</p>
  <!-- os produtos da rádio passam da coluna do main para as capturas ganharem tamanho -->
  <div class="grid gap-5 min-[1200px]:-mx-[120px] print:mx-0">
    <ProjectFeatured project={featuredProject} />
    <div class="grid gap-5 md:grid-cols-2">
      {radioProjects.map((project) => <ProjectCard project={project} />)}
    </div>
  </div>

  <h3 class="mt-14 mb-4 text-lg">Outros projetos</h3>
  {otherProjects.map((project) => <ProjectRow project={project} />)}
</Section>
