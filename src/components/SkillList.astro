---
import { Icon } from 'astro-icon/components';
import { skills, traits } from '../data/skills';
import Section from './Section.astro';
---

<Section id="habilidades" title="Habilidades">
  <h3 class="mb-4 text-lg">Linguagens e ferramentas</h3>
  <ul class="mb-10 flex flex-wrap gap-2.5">
    {skills.map(({ name, icon }) => (
      <li class="inline-flex items-center gap-2 rounded-md bg-accent-soft px-3.5 py-1.5 text-sm font-bold text-accent">
        <Icon name={icon} class="size-4" aria-hidden="true" />
        {name}
      </li>
    ))}
  </ul>

  <h3 class="mb-4 text-lg">O que mais</h3>
  <ul class="grid gap-2.5 text-[17px]">
    {traits.map((text) => (
      <li class="flex items-start gap-3">
        <Icon name="mdi:check" class="mt-1 size-5 shrink-0 text-accent" aria-hidden="true" />
        {text}
      </li>
    ))}
  </ul>
</Section>
