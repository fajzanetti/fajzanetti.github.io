---
import { Icon } from 'astro-icon/components';
import { mainStack, otherSkills } from '../data/skills';
import Section from './Section.astro';
---

<Section id="habilidades" title="Habilidades">
  <h3 class="mb-4 text-lg">Stack principal</h3>
  <ul class="grid grid-cols-2 gap-3 sm:grid-cols-4">
    {mainStack.map(({ name, icon }) => (
      <li class="flex flex-col items-center gap-3 rounded-2xl border border-rule bg-surface px-3 py-5 text-center transition-colors hover:border-accent">
        <Icon name={icon} class="size-8 text-accent" aria-hidden="true" />
        <span class="text-sm font-bold">{name}</span>
      </li>
    ))}
  </ul>

  <h3 class="mt-12 mb-2 text-lg">Também trabalho com</h3>
  <dl class="divide-y divide-rule">
    {otherSkills.map(({ title, skills }) => (
      <div class="grid gap-1 py-4 md:grid-cols-[170px_1fr] md:gap-8">
        <dt class="text-sm font-bold text-accent md:pt-0.5">{title}</dt>
        <dd class="flex flex-wrap gap-x-5 gap-y-2 text-[15px]">
          {skills.map(({ name, icon }) => (
            <span class="inline-flex items-center gap-1.5">
              <Icon name={icon} class="size-4 text-muted" aria-hidden="true" />
              {name}
            </span>
          ))}
        </dd>
      </div>
    ))}
  </dl>
</Section>
