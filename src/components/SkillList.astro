---
import { Icon } from 'astro-icon/components';
import { skills } from '../data/skills';
import Section from './Section.astro';
---

<Section id="habilidades" title="Habilidades">
  <h3 class="mb-4 text-lg">Linguagens e ferramentas</h3>
  <ul class="flex flex-wrap gap-2.5">
    {skills.map(({ name, icon }) => (
      <li class="inline-flex items-center gap-2 rounded-md bg-accent-soft px-3.5 py-1.5 text-sm font-bold text-accent">
        <Icon name={icon} class="size-4" aria-hidden="true" />
        {name}
      </li>
    ))}
  </ul>
</Section>
