---
import { Icon } from 'astro-icon/components';
import { skillGroups } from '../data/skills';
import Section from './Section.astro';
---

<Section id="habilidades" title="Habilidades">
  <ul class="grid gap-5 md:grid-cols-2">
    {skillGroups.map(({ title, skills }, index) => (
      <li class="rounded-2xl border border-rule bg-surface p-6">
        <div class="mb-5 flex items-baseline justify-between gap-4">
          <h3 class="text-xl">
            <span class="mr-2 font-body text-sm font-bold text-accent">{String(index + 1).padStart(2, '0')}</span>
            {title}
          </h3>
          <span class="shrink-0 text-xs font-bold tracking-wide text-muted uppercase">{skills.length} itens</span>
        </div>
        <ul class="flex flex-wrap gap-2">
          {skills.map(({ name, icon }) => (
            <li class="inline-flex items-center gap-2 rounded-full border border-rule bg-bg px-3 py-1.5 text-sm text-text transition-colors hover:border-accent">
              <Icon name={icon} class="size-4 text-accent" aria-hidden="true" />
              {name}
            </li>
          ))}
        </ul>
      </li>
    ))}
  </ul>
</Section>
