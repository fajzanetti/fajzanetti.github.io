---
import { Icon } from 'astro-icon/components';
import { profile } from '../data/profile';

interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
---

<a
  href={profile.cvPath}
  download
  class:list={[
    'inline-flex items-center justify-center rounded-full font-bold text-bg transition-colors hover:bg-accent',
    compact ? 'gap-1.5 bg-muted px-4 py-2 text-xs' : 'gap-2 bg-text px-6 py-3 text-sm',
  ]}
>
  Baixar currículo (PDF)
  <Icon name="mdi:download" class={compact ? 'size-3.5' : 'size-4'} aria-hidden="true" />
</a>
