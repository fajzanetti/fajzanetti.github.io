---
import { education } from '../data/education';
import { formatPeriod } from '../lib/format';
import ResumeItem from './ResumeItem.astro';
import Section from './Section.astro';
---

<Section id="educacao" title="Educação">
  {education.map((item) => (
    <ResumeItem title={item.institution} subtitle={item.degree} dates={[formatPeriod(item.period)]} />
  ))}
</Section>
