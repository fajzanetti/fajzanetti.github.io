---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import type { Project } from '../data/types';
import { formatPeriod } from '../lib/format';

interface Props {
  project: Project;
}
const { project } = Astro.props;
---

<article class="overflow-hidden rounded-2xl border border-rule bg-surface">
  <div class="p-6 md:p-8">
    <p class="text-xs font-bold tracking-wide text-muted uppercase">Projeto em destaque · {formatPeriod(project.period)}</p>
    <div class="mt-3 flex items-center gap-4">
      {project.logo && <Image src={project.logo} alt="" width={112} height={112} class="size-14 rounded-xl border border-rule" />}
      <div>
        <h3 class="text-3xl leading-none">{project.name}</h3>
        <p class="mt-2 text-lg text-muted">{project.tagline}</p>
      </div>
    </div>
    <ul class="mt-6 grid gap-2 md:grid-cols-2 md:gap-x-8">
      {project.description.map((text) => (
        <li class="flex items-start gap-3 text-[15px]">
          <Icon name="mdi:check" class="mt-1 size-4 shrink-0 text-accent" aria-hidden="true" />
          {text}
        </li>
      ))}
    </ul>
    <div class="mt-6 flex flex-wrap items-center justify-between gap-4">
      <ul class="flex flex-wrap gap-2">
        {project.stack.map((item) => (
          <li class="rounded-full bg-accent-soft px-3 py-1 text-xs font-bold text-accent">{item}</li>
        ))}
      </ul>
      {project.note && (
        <p class="inline-flex items-center gap-2 text-sm text-muted">
          <Icon name="mdi:lock-outline" class="size-4" aria-hidden="true" />
          {project.note}
        </p>
      )}
    </div>
  </div>
  {project.image && (
    <Image
      src={project.image}
      alt={project.imageAlt ?? ''}
      width={1600}
      class="w-full border-t border-rule"
    />
  )}
</article>
