---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import type { Project } from '../data/types';
import { formatPeriod } from '../lib/format';

interface Props {
  project: Project;
}
const { project } = Astro.props;
---

<article class="grid gap-8 rounded-2xl border border-rule bg-surface p-6 md:grid-cols-[1fr_220px] md:p-8">
  <div>
    <p class="text-xs font-bold tracking-wide text-muted uppercase">Projeto em destaque · {formatPeriod(project.period)}</p>
    <h3 class="mt-2 text-3xl">{project.name}</h3>
    <p class="mt-2 text-lg text-muted">{project.tagline}</p>
    <ul class="mt-5 grid gap-2">
      {project.description.map((text) => (
        <li class="flex items-start gap-3 text-[15px]">
          <Icon name="mdi:check" class="mt-1 size-4 shrink-0 text-accent" aria-hidden="true" />
          {text}
        </li>
      ))}
    </ul>
    <ul class="mt-6 flex flex-wrap gap-2">
      {project.stack.map((item) => (
        <li class="rounded-full bg-accent-soft px-3 py-1 text-xs font-bold text-accent">{item}</li>
      ))}
    </ul>
    {project.note && (
      <p class="mt-5 inline-flex items-center gap-2 text-sm text-muted">
        <Icon name="mdi:lock-outline" class="size-4" aria-hidden="true" />
        {project.note}
      </p>
    )}
  </div>
  {project.image && (
    <Image
      src={project.image}
      alt={project.imageAlt ?? ''}
      width={440}
      height={440}
      class="mx-auto w-40 rounded-2xl border border-rule md:w-full"
    />
  )}
</article>
