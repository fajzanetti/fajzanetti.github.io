---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import type { Project } from '../data/types';
import { formatPeriod } from '../lib/format';
import StackList from './StackList.astro';

interface Props {
  project: Project;
}
const { project } = Astro.props;
---

<article class="overflow-hidden rounded-3xl bg-ink text-bg print:border print:border-rule print:bg-surface print:text-text">
  <div class="grid lg:grid-cols-[minmax(0,5fr)_minmax(0,6fr)]">
    <div class="p-7 md:p-12">
      <p class="text-sm font-bold text-accent-soft print:text-accent">{formatPeriod(project.period)}</p>
      <div class="mt-4 flex items-center gap-4">
        {project.logo && <Image src={project.logo} alt="" width={128} height={128} class="size-14 shrink-0 rounded-2xl md:size-16" />}
        <h3 class="text-4xl leading-none md:text-5xl">{project.name}</h3>
      </div>
      <p class="mt-6 text-xl leading-snug md:text-2xl">{project.tagline}</p>
      {project.note && (
        <p class="mt-6 flex items-center gap-2 text-sm text-bg/70 print:text-muted">
          <Icon name="mdi:lock-outline" class="size-4 shrink-0" aria-hidden="true" />
          {project.note}
        </p>
      )}
    </div>
    {project.image && (
      <div class="relative h-60 overflow-hidden sm:h-80 lg:h-auto print:hidden">
        <Image
          src={project.image}
          alt={project.imageAlt ?? ''}
          width={1600}
          class="absolute top-0 left-7 w-[200%] max-w-none rounded-tl-xl shadow-[0_0_60px_rgb(0_0_0/0.45)] md:left-12 md:w-[150%] lg:top-12 lg:left-0 lg:w-[185%]"
        />
      </div>
    )}
  </div>
  <div class="border-t border-bg/15 p-7 md:px-12 md:py-9 print:border-rule">
    <ul class="mb-7 grid gap-x-8 gap-y-4 sm:grid-cols-2 lg:grid-cols-4">
      {project.description.map((text) => <li class="text-sm text-bg/80 print:text-muted">{text}</li>)}
    </ul>
    <StackList stack={project.stack} onInk />
  </div>
</article>
