---
import { Icon } from 'astro-icon/components';
import { profile } from '../data/profile';
import { nav } from '../data/nav';

const fullName = `${profile.firstName} ${profile.lastName}`;
---

<header class="sticky top-0 z-10 border-b border-rule bg-bg/95 backdrop-blur">
  <div class="relative mx-auto flex max-w-[880px] items-center justify-between gap-6 px-6 py-3 md:py-5">
    <a href="#sobre" class="font-heading text-[28px] leading-none font-bold text-text" aria-label={`FZ, ${fullName}, voltar ao início`}>
      {profile.firstName[0]}<em class="text-accent-bright">{profile.lastName[0]}</em>
    </a>

    <button
      id="menu-toggle"
      type="button"
      class="-mr-2 rounded-md p-2 text-text md:hidden"
      aria-expanded="false"
      aria-controls="site-nav"
      aria-label="Abrir menu"
    >
      <Icon name="mdi:menu" class="size-6" data-icon="open" aria-hidden="true" />
      <Icon name="mdi:close" class="hidden size-6" data-icon="close" aria-hidden="true" />
    </button>

    <nav
      id="site-nav"
      aria-label="Seções"
      class="absolute inset-x-0 top-full hidden border-b border-rule bg-bg md:static md:block md:border-0 md:bg-transparent"
    >
      <ul class="flex flex-col px-6 py-2 text-sm font-bold md:flex-row md:gap-6 md:p-0">
        {nav.map(({ id, label }) => (
          <li>
            <a
              href={`#${id}`}
              class="block py-3 text-muted transition-colors hover:text-accent aria-[current=page]:text-accent md:py-0"
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script src="../scripts/menu.ts"></script>
<script src="../scripts/scrollspy.ts"></script>
