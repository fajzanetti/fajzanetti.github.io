---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import avatar from '../assets/avatar.png';
import { profile } from '../data/profile';
import CvButton from './CvButton.astro';
import SocialLinks from './SocialLinks.astro';

const [lead, ...details] = profile.summary;
---

<!-- a altura desconta o header fixo para a seção fechar na primeira dobra -->
<section id="sobre" class="flex min-h-[calc(100svh-3.25rem)] flex-col md:min-h-[calc(100svh-4.25rem)]">
  <div class="flex flex-1 flex-col-reverse justify-center gap-8 py-8 md:flex-row md:items-center md:gap-16 md:py-16 md:short:py-6">
    <div class="flex max-w-[580px] flex-col">
      <p class="text-sm font-bold text-accent">
        {profile.title}, {profile.city}
      </p>
      <h1 class="mt-4 text-5xl leading-none font-semibold md:text-7xl lg:text-[88px]">
        {profile.firstName} <em class="text-accent-bright">{profile.lastName}</em>
      </h1>

      <p class="mt-8 text-xl leading-snug md:text-2xl md:short:mt-5">{lead}</p>
      <div class="mt-5 space-y-3 text-[17px] leading-relaxed text-muted">
        {details.map((text) => <p>{text}</p>)}
      </div>

      <div class="mt-10 hidden items-center gap-6 md:flex md:short:mt-6" data-print="hide">
        <CvButton />
        <SocialLinks socials={profile.socials} />
      </div>
    </div>

    <!-- no mobile as ações ocupam o espaço vazio ao lado da foto -->
    <div class="flex max-w-[580px] items-center justify-between gap-3">
      <div class="avatar-ring size-20 shrink-0 rounded-full p-[3px] min-[360px]:size-28 md:size-56">
        <div class="size-full rounded-full bg-bg p-1">
          <Image
            src={avatar}
            alt={`Foto de ${profile.firstName} ${profile.lastName}`}
            width={224}
            height={224}
            loading="eager"
            class="size-full rounded-full object-cover"
          />
        </div>
      </div>
      <div class="flex flex-col gap-1 md:hidden" data-print="hide">
        <SocialLinks socials={profile.socials} />
        <CvButton compact />
      </div>
    </div>
  </div>

  <a
    href="#experiencias"
    class="hidden items-center gap-2 self-start pb-6 text-sm font-bold text-muted transition-colors hover:text-accent md:flex md:short:pb-3"
    data-print="hide"
  >
    <Icon name="mdi:chevron-down" class="size-4 motion-safe:animate-bounce" aria-hidden="true" />
    Role para ver mais
  </a>
</section>
