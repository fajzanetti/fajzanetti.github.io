---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import avatar from '../assets/avatar.png';
import { profile } from '../data/profile';
import SocialLinks from './SocialLinks.astro';
---

<section id="sobre" class="py-14 md:py-24">
  <div class="flex flex-col-reverse gap-10 md:flex-row md:items-center md:justify-between">
    <div>
      <h1 class="text-5xl leading-none font-semibold md:text-7xl lg:text-[88px]">
        {profile.firstName} <em class="text-accent-bright">{profile.lastName}</em>
      </h1>
      <p class="mt-5 text-xl text-muted">{profile.title} — {profile.city}</p>
      <div class="mt-7 max-w-[620px] text-lg">
        {profile.summary.map((text) => <p>{text}</p>)}
      </div>
      <div class="mt-8 flex flex-wrap items-center gap-6">
        <a
          href={profile.cvPath}
          download
          class="inline-flex items-center gap-2 rounded-full border-[1.5px] border-text px-5 py-3 text-sm font-bold text-text transition-colors hover:bg-text hover:text-bg"
        >
          Baixar currículo (PDF)
          <Icon name="mdi:download" class="size-4" aria-hidden="true" />
        </a>
        <SocialLinks socials={profile.socials} />
      </div>
    </div>
    <Image
      src={avatar}
      alt={`Foto de ${profile.firstName} ${profile.lastName}`}
      width={176}
      height={176}
      loading="eager"
      class="size-32 shrink-0 rounded-full border-4 border-accent-soft object-cover md:size-44"
    />
  </div>
</section>
